---
import BaseLayout from '@/layouts/BaseLayout.astro'
import fetchApi from '@/lib/strapi'
import type Project from '@/interfaces/project'
import Card from '@/components/Card.astro'
import Image from 'astro/components/Image.astro'
import { ArrowRight } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import {
  BlocksRenderer,
  type BlocksContent,
} from '@strapi/blocks-react-renderer'

export const prerender = false

const { slug } = Astro.params

let project: Project | undefined

try {
  project = await fetchApi<Project>({
    endpoint: `projects?filters[slug][$eq]=${slug}&populate=*`,
    wrappedByKey: 'data',
    wrappedByList: true,
  })
} catch (error) {
  return Astro.redirect('/', 500)
}

if (!project) {
  return Astro.redirect('/', 404)
}

const projectDescription: BlocksContent = project.description
---

<BaseLayout
  server:defer
  title={`Project | ${project?.name}`}
  description={`${project?.name} project page`}
>
  <main
    class="relative mx-auto grid w-full max-w-6xl gap-2 px-2 overflow-hidden sm:gap-2 sm:px-4 md:grid-cols-2 md:gap-3 md:px-6 lg:grid-cols-4 lg:grid-rows-4 lg:gap-4"
  >
    <Card colSpan="md:col-span-4" rowSpan="md:row-span-1" title="title">
      <header class="flex items-center">
        <h2 class="text-xl font-bold text-primary">
          {project?.name}
        </h2>
      </header>
    </Card>
    <Card
      colSpan="lg:col-span-2 md:col-span-4"
      rowSpan="lg:row-span-3"
      title="image"
    >
      <div class="flex mt-2 justify-center items-center h-full w-full">
        {
          project?.image && (
            <Image
              width="500"
              height="242"
              alt={project?.name || ''}
              src={
                import.meta.env.STRAPI_URL + project?.image.formats.small.url
              }
              class="object-cover pointer-events-none select-none rounded-md"
              loading="lazy"
            />
          )
        }
      </div>
    </Card>
    <Card
      colSpan="lg:col-span-2 md:col-span-4"
      rowSpan="lg:row-span-4"
      title="description"
    >
      <div class="flex h-full flex-col m-0 text-md font-light text-primary">
        {
          project?.description && (
            <BlocksRenderer content={projectDescription} />
          )
        }
      </div>
    </Card>
    <Card
      colSpan="lg:col-span-2 md:col-span-4"
      rowSpan="md:row-span-1"
      title="url"
    >
      <div class="mt-4 flex w-full justify-center">
        <div
          class="card card-compact md:w-112 lg:w-128 w-96 gap-2 border-[oklch(var(--p))] transition-all"
        >
          <div
            class="card-actions mt-2 flex w-full items-center justify-center"
          >
            <a
              href={project?.url}
              class={buttonVariants({ variant: 'default' })}
            >
              Visit project page
              <ArrowRight />
            </a>
          </div>
        </div>
      </div>
    </Card>
  </main>
  <BaseLayout
    slot="fallback"
    title={`Project | ${project?.name}`}
    description={`${project?.name} project page`}
  >
    <main
      class="relative mx-auto grid w-full max-w-6xl gap-2 px-2 overflow-hidden sm:gap-2 sm:px-4 md:grid-cols-2 md:gap-3 md:px-6 lg:grid-cols-4 lg:grid-rows-4 lg:gap-4 animate-pulse"
    >
      <Card colSpan="md:col-span-4" rowSpan="md:row-span-1" title="">
        <div class="h-13 w-1/3 bg-secondary/30 rounded"></div>
      </Card>

      <Card
        colSpan="lg:col-span-2 md:col-span-4"
        rowSpan="lg:row-span-3"
        title=""
      >
        <div class="flex mt-2 justify-center items-center h-full w-full">
          <div
            class="w-full h-full min-h-[242px] max-h-[500px] bg-secondary/30 rounded-md"
          >
          </div>
        </div>
      </Card>

      <Card
        colSpan="lg:col-span-2 md:col-span-4"
        rowSpan="lg:row-span-4"
        title=""
      >
        <div class="flex flex-col gap-4 p-4">
          <div class="h-4 w-full bg-secondary/20 rounded"></div>
          <div class="h-4 w-full bg-secondary/20 rounded"></div>
          <div class="h-4 w-3/4 bg-secondary/20 rounded"></div>
        </div>
      </Card>

      <Card colSpan="md:col-span-2" rowSpan="md:row-span-1" title="">
        <div class="h-21 w-1/3 bg-secondary/30 rounded"></div>
      </Card>
    </main>
  </BaseLayout>
</BaseLayout>
