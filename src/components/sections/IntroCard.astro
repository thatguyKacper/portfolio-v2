---
import Card from '../Card.astro'
import { Button, buttonVariants } from '@/components/ui/button'
import { LINKS } from '@/lib/constants'
import { Linkedin, Github, Mail } from 'lucide-react'
---

<Card colSpan="md:col-span-2" rowSpan="md:row-span-2" title="welcome">
  <div class="flex w-full mt-2">
    <div class="flex flex-col justify-between gap-4">
      <div class="flex h-full flex-col">
        <p class="m-0 text-xl font-light text-primary">
          Hi, I'm <b class="font-bold">Kacper Wójtowicz</b>, Fullstack developer
          with five years of experience and a serious obsession with home labs.
          I love clean interfaces and stable infrastructure. I am currently
          focused on Proxmox, Docker and networking.
        </p>
      </div>
      <div class="flex gap-4 pb-6">
        <a
          href={LINKS.github}
          aria-label="github profile"
          target="_blank"
          class={buttonVariants({ variant: 'default', size: 'icon' })}
        >
          <Github />
          <span class="sr-only">GitHub Profile</span>
        </a>
        <a
          href={LINKS.linkedin}
          aria-label="linkedin profile"
          target="_blank"
          class={buttonVariants({ variant: 'default', size: 'icon' })}
        >
          <Linkedin />
          <span class="sr-only">Linkedin Profile</span>
        </a>
        <a
          href={`mailto:${LINKS.mail}`}
          aria-label="mail profile"
          class={buttonVariants({ variant: 'default', size: 'icon' })}
        >
          <Mail />
          <span class="sr-only">Email contact</span>
        </a>
      </div>
    </div>
  </div>
</Card>
